FROM docker.io/library/golang:1.22-bookworm AS build
ARG VERSION=0.1.0-dev
WORKDIR /src
COPY tlslab/go.mod ./
COPY tlslab/cmd ./cmd
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go test ./... \
 && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath \
      -ldflags "-s -w -X main.version=${VERSION}" \
      -o /certlab-gm ./cmd/certlab-gm

FROM scratch
COPY --from=build /certlab-gm /certlab-gm
ENTRYPOINT ["/certlab-gm"]
