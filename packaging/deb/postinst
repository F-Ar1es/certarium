#!/bin/sh
set -e
if ! getent group certarium >/dev/null; then
    addgroup --system certarium
fi
if ! getent passwd certarium >/dev/null; then
    adduser --system --ingroup certarium --home /var/lib/certarium --no-create-home --disabled-login --gecos 'Certarium service account' certarium
fi
install -d -m 0700 -o certarium -g certarium /var/lib/certarium
if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable --now certarium.service >/dev/null 2>&1 || true
fi
exit 0
