[Unit]
Description=Certarium local certificate laboratory
After=network.target

[Service]
Type=simple
User=certarium
Group=certarium
UMask=0077
EnvironmentFile=-/etc/certarium/certarium.env
ExecStart=/usr/bin/certarium -listen 127.0.0.1:8080 -data-dir /var/lib/certarium -tongsuo /opt/certarium/bin/openssl -crypto-timeout ${CERTARIUM_CRYPTO_TIMEOUT} -ca-passphrase-file /etc/certarium/ca.pass
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/certarium

[Install]
WantedBy=multi-user.target
